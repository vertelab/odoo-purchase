        <field name="sequence">140</field>
        <field name="slide_category">quiz</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="completion_time">0.25</field>
        <field name="quiz_first_attempt_reward">100</field>
        <field name="quiz_second_attempt_reward">75</field>
        <field name="quiz_third_attempt_reward">50</field>
        <field name="quiz_fourth_attempt_reward">25</field>
        <field name="description">Testa dina kunskaper om Order Deadline och Expected Arrival.</field>
    </record>

    <record id="slide_s3_04_q1" model="slide.question">
        <field name="question">Vad betyder ett Expected Arrival som ligger långt fram i tiden?</field>
        <field name="sequence">1</field>
    </record>

    <record id="slide_s3_04_q1_a1" model="slide.answer">
        <field name="text_value">Leverantörens ledtid plus säkerhetstiden är lång</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Expected Arrival = Order Deadline + ledtid + säkerhetstid.</field>
    </record>

    <record id="slide_s3_04_q1_a2" model="slide.answer">
        <field name="text_value">Odoo har räknat fel</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Kontrollera ledtiderna först — de förklarar nästan alltid datumet.</field>
    </record>

    <record id="slide_s3_04_q1_a3" model="slide.answer">
        <field name="text_value">Ordern är försenad</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Ordern är ett förslag; datumet är en framräkning.</field>
    </record>

    <record id="slide_s3_04_q2" model="slide.question">
        <field name="question">Vad är Order Deadline när förslaget skapas av en påfyllnadsregel?</field>
        <field name="sequence">2</field>
    </record>

    <record id="slide_s3_04_q2_a1" model="slide.answer">
        <field name="text_value">Planeringsdagen — ofta dagens datum</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Behovet finns redan, så ordern ska läggas nu.</field>
    </record>

    <record id="slide_s3_04_q2_a2" model="slide.answer">
        <field name="text_value">Samma datum som Expected Arrival</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Då vore ledtiden noll.</field>
    </record>

    <record id="slide_s3_04_q2_a3" model="slide.answer">
        <field name="text_value">Leverantörens sista orderdag</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Det är inte vad fältet betyder.</field>
    </record>

    <record id="slide_s3_04_q3" model="slide.question">
        <field name="question">En order har flera rader med olika date_planned. Vilket datum visas på ordern?</field>
        <field name="sequence">3</field>
    </record>

    <record id="slide_s3_04_q3_a1" model="slide.answer">
        <field name="text_value">Det tidigaste av radernas datum</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! date_planned på ordern = min(alla raders date_planned).</field>
    </record>

    <record id="slide_s3_04_q3_a2" model="slide.answer">
        <field name="text_value">Det senaste av radernas datum</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Odoo väljer det tidigaste.</field>
    </record>

    <record id="slide_s3_04_q3_a3" model="slide.answer">
        <field name="text_value">Genomsnittet av radernas datum</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Inget medelvärde beräknas.</field>
    </record>

</odoo>
